<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/looply_widget_background"
    android:padding="16dp">

    <!-- Cabeçalho: 📚 Looply -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📚 Looply"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1A1A1A"
        android:layout_marginBottom="10dp" />

    <!-- Linha: Hoje -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hoje"
            android:textSize="13sp"
            android:textColor="#5A5A5A" />

        <TextView
            android:id="@+id/widget_today_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A" />
    </LinearLayout>

    <!-- Linha: Pendentes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pendentes"
            android:textSize="13sp"
            android:textColor="#5A5A5A" />

        <TextView
            android:id="@+id/widget_pending_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#D9534F" />
    </LinearLayout>

    <!-- Mensagem de "tudo em dia", visível apenas quando hoje=0 e pendentes=0 -->
    <TextView
        android:id="@+id/widget_all_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎉 Tudo em dia!"
        android:textSize="12sp"
        android:textColor="#3E8E41"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
